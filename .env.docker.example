# Aegis Sentinel — Docker Deployment Environment Template
# Copy to .env.docker and set real values. Never commit real secrets.

APP_ENV=production
AEGIS_JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

POSTGRES_DSN=postgresql://aegis:aegis@postgres:5432/aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=aegis

REDIS_URL=redis://redis:6379/0

AEGIS_DEVICE_PREFERENCE=auto
AEGIS_OPEN_VOCAB_PROVIDER=grounding_dino
AEGIS_OPEN_VOCAB_MODEL_PATH=
AEGIS_OPEN_VOCAB_PROCESSOR_PATH=
AEGIS_OPEN_VOCAB_ALLOW_DOWNLOAD=false

# Segmentation model path (optional - defaults to sam2_t.pt via Ultralytics)
AEGIS_SEGMENTATION_MODEL_PATH=sam2_t.pt

# OpenAI / LLM integration
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
OPENAI_LLM_MODEL=gpt-5.4-mini
OPENAI_LLM_ESCALATION_MODEL=gpt-5.4
OPENAI_LLM_FINAL_REPORT_MODEL=gpt-5.5

VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Drone simulation / external tools
AEGIS_COSYS_AIRSIM_ROOT=C:\AegisExternalTools\drone_sim\cosys_airsim\Cosys-AirSim
AEGIS_COSYS_AIRSIM_PYTHONCLIENT_DIR=C:\AegisExternalTools\drone_sim\cosys_airsim\Cosys-AirSim\PythonClient
AEGIS_DRONE_SIM_CLIENT=cosysairsim
AEGIS_DRONE_SIM_ENABLED=false
AEGIS_DRONE_SIM_PROVIDER=cosys_airsim
AEGIS_AIRSIM_HOST=127.0.0.1
AEGIS_AIRSIM_PORT=41451
AEGIS_AIRSIM_VEHICLE=Drone1
AEGIS_AIRSIM_CAMERA=front_center
AEGIS_DRONE_SIM_SETTINGS_PATH=%USERPROFILE%\Documents\AirSim\settings.json
AEGIS_DRONE_SIM_RUNTIME_DIR=C:\AegisExternalTools\drone_sim\runtime
