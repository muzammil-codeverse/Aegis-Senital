# Aegis Sentinel — Local Development Environment Template
# Copy to .env and fill in values. Never commit real secrets.

APP_ENV=dev
AEGIS_JWT_SECRET=change-this-in-production-use-a-long-random-string
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Database (optional in dev — SQLite fallback if not set)
POSTGRES_DSN=
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis

# Redis (optional in dev — in-memory fallback if not set)
REDIS_URL=

# Device preference: auto, cuda, cpu
AEGIS_DEVICE_PREFERENCE=auto

# Open-Vocab model (optional - scanner degrades gracefully if not set)
# Run: python scripts/setup_open_vocab_model.py  to download
AEGIS_OPEN_VOCAB_PROVIDER=grounding_dino
AEGIS_OPEN_VOCAB_MODEL_PATH=
AEGIS_OPEN_VOCAB_PROCESSOR_PATH=
AEGIS_OPEN_VOCAB_ALLOW_DOWNLOAD=false

# Segmentation model path (optional - defaults to sam2_t.pt via Ultralytics)
AEGIS_SEGMENTATION_MODEL_PATH=sam2_t.pt

# Roboflow dataset restoration (local only; never commit a real key)
ROBOFLOW_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# GIS / map (Phase 42) — local_mock works without paid keys
VITE_MAP_PROVIDER=local_mock
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.4-mini
OPENAI_LLM_ESCALATION_MODEL=gpt-5.4
OPENAI_LLM_FINAL_REPORT_MODEL=gpt-5.5

# Drone simulation / external tools
AEGIS_COSYS_AIRSIM_ROOT=C:\AegisExternalTools\drone_sim\cosys_airsim\Cosys-AirSim
AEGIS_COSYS_AIRSIM_PYTHONCLIENT_DIR=C:\AegisExternalTools\drone_sim\cosys_airsim\Cosys-AirSim\PythonClient
AEGIS_DRONE_SIM_CLIENT=cosysairsim
